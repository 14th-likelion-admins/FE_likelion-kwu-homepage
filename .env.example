# GitHub App (조직 설치형) — 개인 계정 소속과 무관하게 유지되는 인증.
# 기수가 바뀌어 발급자가 조직을 떠나도 끊기지 않는다.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# .pem 개인키를 base64로 한 줄 인코딩한 값 (줄바꿈 손상 방지)
GITHUB_APP_PRIVATE_KEY_BASE64=
# GitHub repository in owner/repository format (for example, likelion-kwu/14th-official-homepage-frontend)
GITHUB_REPO=
# Shared passphrase used by the content registration forms
CONTENT_WRITE_PASSPHRASE=
